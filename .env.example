# Copy these into Hostinger's Environment Variables screen (or .env.local on your Mac).
# NEXT_PUBLIC_* and ALLOW_INDEXING are read at BUILD time: set them BEFORE running the build.

NEXT_PUBLIC_SITE_URL=https://brightsunseo.com
ALLOW_INDEXING=false            # change to true only when you are ready for Google to see the site

# Blog admin (/admin) – at least 8 characters
ADMIN_PASSWORD=

# Optional: folder that survives redeploys (blog posts, uploaded pictures, enquiries)
DATA_DIR=

# Optional: send contact-form enquiries to a webhook instead of a file
CONTACT_WEBHOOK_URL=

# Optional: live Search Console numbers
GSC_CLIENT_EMAIL=
GSC_PRIVATE_KEY=
